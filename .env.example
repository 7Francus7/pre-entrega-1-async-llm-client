# Proveedor activo: openai o anthropic. Solo necesita la clave del elegido.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos de ejemplo; deben estar habilitados en tu cuenta del proveedor.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256
# Timeout de red por operación, en segundos; no es un plazo total.
LLM_TIMEOUT=30
# Reintentos adicionales del SDK (0 desactiva los reintentos).
LLM_MAX_RETRIES=2
